  <worksheet xml:id="asgn1-positive-and-negative-space">
    <title>Positive and Negative Space</title>
    <introduction>
      <p>Creating value, balancing positive and negative space</p>
      <p> Artist inspiration: Escher</p>
    </introduction>

    <figure xml:id="figbw1">
    <caption></caption>
    <image source="bw1.jpg" width="55%">
    <shortdescription>photo of student work</shortdescription>
    </image>
    </figure>

    <figure xml:id="figbw2">
