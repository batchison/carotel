<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="sec-sample-exam">
    <title>Introduction to Functions: Exam</title>
    <introduction>
        <p> This is a sample assessment for an introduction to functions course.</p>
    </introduction>
<!-- <subsection xml:id="sec-morabito-exercises">-->
  <worksheet xml:id="ws-morabito">
  <title>Practice Exam - Exponentials and Logarithms</title>
    <exercise number="1">
    <p>
      Create a table with at least two points and graph the following function. Then state the <em>domain</em>, <em>range</em>, and the equation of the <em>horizontal asymptote</em>.
    <md>f(x) = 2^{x-1} + 3</md>
    </p>
    <p>NOTE: You MUST make your graph on a separate paper.</p>
  </exercise>
  <exercise number="2">
    <p>
      Create a table with at least two points and graph the following function. Then state the <em>domain</em>, <em>range</em>, and the equation of the <em>vertical asymptote</em>.
      <md>g(x) = \log_2(x)</md>
    </p>
    <p>NOTE: You MUST make your graph on a separate paper.</p>
  </exercise>

  <exercise number="3">
    <p>
      Create a table with at least two points and graph the following function. Then state the <em>domain</em>, <em>range</em>, and the equation of the <em>vertical asymptote</em>.
            <md>h(x) = \log_3(x-4) + 2</md>
    </p>
    <p>NOTE: You MUST make your graph on a separate paper.</p>
  </exercise>

  <exercise number="4">
    <p>Rewrite each expression using exponential form.</p>
    <ol>
    <li><p><m>\log_2 16 = x</m></p></li>
    <li><p><m>\log_5\left(\frac{1}{125}\right) = x</m></p></li>
    </ol>
  </exercise>

  <exercise number="5">
    <p> Evaluate without a calculator:</p>
    <ol>
    <li><p><m>\log_4 64</m></p></li>
    <li><p><m>\log_{10} 0.01</m></p></li>
    </ol>
  </exercise>

  <exercise number="6">
    <p>Simplify using the <em>properties of exponents</em>.</p>
    <ol>
    <li><p><m>x^3 \cdot x^5</m></p></li>
    <li><p><m>\frac{a^9}{a^4}</m></p></li>
    <li><p><m>(2x^3)^4</m></p></li>
    <li><p><m>(x^2y^3)^2</m></p></li>
    <li><p><m>\frac{5^6}{5^{-2}}</m></p></li>
    </ol>
  </exercise>

  <exercise number="7">
    <p>Rewrite each equation using the other form.</p>
    <ol>
    <li><p><m>3^4 = 81</m></p></li>
    <li><p><m>\log_2 16 = 4</m></p></li>
    <li><p><m>\log_5 125 = 3</m></p></li>
    <li><p><m>10^2 = 100</m></p></li>
    </ol>
  </exercise>

  <exercise number="8">
    <p>Evaluate each logarithm.</p>
    <ol>
    <li><p><m>\log_{10} 1000</m></p></li>
    <li><p><m>\log_2 32</m></p></li>
    <li><p><m>\log_3 81</m></p></li>
    <li><p><m>\log_4 16</m></p></li>
    <li><p><m>\log_5\left(\frac{1}{25}\right)</m></p></li>
    </ol>
  </exercise>

  <exercise number="9">
    <p>Solve each exponential equation.</p>
    <ol>
    <li><p><m>2^x = 16</m></p></li>
    <li><p><m>5^{x-1} = 25</m></p></li>
    </ol>
  </exercise>

  <exercise number="10">
    <p>Solve each logarithmic equation.</p>
    <ol>
    <li><p><m>\log_2(x) = 5</m></p></li>
    <li><p><m>\log(x-3) = 2</m></p></li>
    </ol>
  </exercise>

  <exercise number="11">
    <p>Solve each logarithmic equation after using log properties to write as a single logarithm.</p>
    <ol>
    <li><p><m>\log_2(x) + \log_2(5) = 3</m></p></li>
    <li><p><m>\log(x-3) - \log(4) = 1</m></p></li>
    </ol>
  </exercise>
  </worksheet>

 <subsection xml:id="sec-morabito-nace">
    <title>NACE Competencies</title>
    <p>
      This assignment fulfills NACE competencies 2, 3, and 6 (for more information on NACE competencies, please see the document titled 'NACE Competencies').
    </p>
  </subsection>
